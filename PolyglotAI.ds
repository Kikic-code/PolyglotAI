/*
 * Author       : keerthana.c.2024.cse_raja601
 * Generated on : 31-Oct-2026 13:58:42
 * Version      : 1.0
 */
 application "PolyglotAI"
 {
 	date format = "dd-MMM-yyyy"
 	time zone = "Asia/Kolkata"
 	time format = "24-hr"

 	forms
	{
		form Feedback_Analysis
		{
			success message = "Data Added Successfully!"
			Section
			(
				type = section
	 			row = 1
	 			column = 0   
				width = medium
			)
			Analysis_ID
			(
    			type = autonumber
				displayname = "Analysis ID"
				start index = 1
	 			row = 1
	 			column = 1   
				width = medium
			)
			must have Feedback_Submissions1
			(
				type = picklist	
				displayname = "Feedback Submissions"
				values  = Feedback_Submissions.ID
    			displayformat = [Feedback_ID]
				sortorder = ascending
	 			row = 1
	 			column = 1   
				width = medium
			)
			Detected_Languages
			(
    			type = text
				displayname = "Detected Languages"
	 			row = 1
	 			column = 1   
				width = medium
			)
			Sentiment
			(
				type = picklist
				maxchar = 100
				values = {"Positive","Neutral","Negative","Mixed","Uncertain"}
	 			row = 1
	 			column = 1   
				width = medium
			)
			Primary_Emotion
			(
				type = picklist
				displayname = "Primary Emotion"
				maxchar = 100
				values = {"Joy","Anger","Sadness","Fear","Surprise","Disgust","Frustration","Trust","Other","Uncertain"}
	 			row = 1
	 			column = 1   
				width = medium
			)
			Possible_Sarcasm
			(
				type = picklist
				displayname = "Possible Sarcasm"
				maxchar = 100
				values = {"Yes","No","Uncertain"}
	 			row = 1
	 			column = 1   
				width = medium
			)
			Main_Topic
			(
    			type = text
				displayname = "Main Topic"
	 			row = 1
	 			column = 1   
				width = medium
			)
			Feedback_Summary
			(
    			type = textarea
				displayname = "Feedback Summary"
				height = 100px
	 			row = 1
	 			column = 1   
				width = medium
			)
			Urgency
			(
				type = picklist
				maxchar = 100
				values = {"Low","Medium","High","Critical"}
	 			row = 1
	 			column = 1   
				width = medium
			)
			Confidence_Level
			(
				type = number
				displayname = "Confidence Level"
	 			row = 1
	 			column = 1   
				width = medium
			)
			Requires_Review
			(
				type = checkboxes	
				displayname = "Requires Review"
				values = {"Yes","No"}
	 			row = 1
	 			column = 1   
				width = medium
			)
			Analysis_Status
			(
				type = picklist
				maxchar = 100
				values = {"Pending","Completed","Failed","Needs Review"}
	 			row = 1
	 			column = 1   
				width = medium
			)
			Google_Event_ID
			(
    			type = text
				displayname = "Google Event ID"
	 			row = 1
	 			column = 1   
				width = medium
			)
			Google_Event_Link
			(
    			type = url
				displayname = "Google Event Link"
				enable  linkname
	 			row = 1
	 			column = 1   
				width = medium
			)
	
			actions
			{
				on add
				{
					submit
					(
   						type = submit
   						displayname = "Submit"
					)
				}
				on edit
				{
					update
					(
   						type = submit
   						displayname = "Update"
					)
					cancel
					(
   						type = cancel
   						displayname = "Cancel"
					)
				}
			}
		}
		form Feedback_Review
		{
			success message = "Feedback Review Added Successfully"
			Section
			(
				type = section
	 			row = 1
	 			column = 0   
				width = medium
			)
			Feedback_Analysis1
			(
				type = picklist	
				displayname = "Feedback Analysis"
				values  = Feedback_Analysis.ID
    			displayformat = [Analysis_ID]
				sortorder = ascending
	 			row = 1
	 			column = 1   
				width = medium
			)
			must have Review_Status
			(
				type = picklist
				displayname = "Review Status"
				maxchar = 100
				values = {"Pending Review","Reviewed","Correction Required"}
	 			row = 1
	 			column = 1   
				width = medium
			)
			Corrected_Sentiment
			(
				type = picklist
				displayname = "Corrected Sentiment"
				maxchar = 100
				values = {"Positive","Neutral","Negative","Mixed","Uncertain"}
	 			row = 1
	 			column = 1   
				width = medium
			)
			Corrected_Emotion
			(
				type = picklist
				displayname = "Corrected Emotion"
				maxchar = 100
				values = {"Joy","Anger","Sadness","Fear","Surprise","Disgust","Frustration","Trust","Other","Uncertain"}
	 			row = 1
	 			column = 1   
				width = medium
			)
			Sarcasm_Confirmed
			(
				type = picklist
				displayname = "Sarcasm Confirmed"
				maxchar = 100
				values = {"Yes","No","Uncertain"}
	 			row = 1
	 			column = 1   
				width = medium
			)
			Reviewer_Notes
			(
    			type = textarea
				displayname = "Reviewer Notes"
				height = 100px
    			description
    			[
    				type = help_text
    			 	message = "Explain why the AI result was wrong or what context was missing"
    			]
	 			row = 1
	 			column = 1   
				width = medium
			)
			Reviewed_By
			(
    			type = text
				displayname = "Reviewed By"
	 			row = 1
	 			column = 1   
				width = medium
			)
			Events
			(
				type = picklist	
				datasource = google_calendar_events
    			displayformat = [title]
	 			row = 1
	 			column = 1   
				width = medium
			)
	
			actions
			{
				on add
				{
					submit
					(
   						type = submit
   						displayname = "Submit"
					)
				}
				on edit
				{
					update
					(
   						type = submit
   						displayname = "Update"
					)
					cancel
					(
   						type = cancel
   						displayname = "Cancel"
					)
				}
			}
		}
		form Feedback_Submissions
		{
			captcha = true
			success message = "Thank You for your valuable feedback!"
			Section
			(
				type = section
	 			row = 1
	 			column = 0   
				width = medium
			)
			Feedback_ID
			(
    			type = autonumber
				displayname = "Feedback ID"
				start index = 1
	 			row = 1
	 			column = 1   
				width = medium
			)
			must have Feedback_Category
			(
				type = picklist
				displayname = "Feedback Category"
				maxchar = 100
				values = {"Product","Service","Delivery","Billing","Support","Other"}
	 			row = 1
	 			column = 1   
				width = medium
			)
			must have Product_Service_Name
			(
    			type = text
				displayname = "Business/Brand Name"
	 			row = 1
	 			column = 1   
				width = medium
			)
			Prod
			(
    			type = text
				displayname = "Product/Service Name"
	 			row = 1
	 			column = 1   
				width = medium
			)
			Customer_Name
			(
    			type = name
				displayname = "Customer Name"
     			prefix
     			(
	     			 type = prefix
	     			 displayname ="Prefix"
	     			 visibility = false
	     			 value = {"Mr.","Mrs.","Ms."}
     			) 
     			first_name
     			(
	     			 type = first_name
	     			 displayname ="First Name"
     			) 
     			last_name
     			(
	     			 type = last_name
	     			 displayname ="Last Name"
     			) 
     			suffix
     			(
	     			 type = suffix
	     			 displayname ="Suffix"
	     			 visibility = false
     			) 
	 			row = 1
	 			column = 1   
				width = medium
				personal data = true
			)
			Customer_Email
			(
    			type = email
				displayname = "Customer Email"
				maxchar = 80
	 			row = 1
	 			column = 1   
				width = medium
				personal data = true
			)
			must have Rating
			(
				type = picklist
				displayname = "Overall Rating"
				maxchar = 100
				values = {"1","2","3","4","5"}
	 			row = 1
	 			column = 1   
				width = medium
			)
			must have Your_Feedback
			(
    			type = richtext
				displayname = "Your Feedback"
				height = 200px
				toolbar = enable
				[
					style, font-color, background-color, link, bullets-and-numbering, 
					font-size : {1, 2, 3, 4, 5, 6, 7}
				]
	 			row = 1
	 			column = 1   
				width = medium
			)
			Preffered_Languange
			(
				type = picklist
				displayname = "Prefered Language"
				maxchar = 100
				values = {"Auto Detect","English","Tamil","Hindi","Telugu","Malayalam","Kannada","Other"}
	 			row = 1
	 			column = 1   
				width = medium
			)
			Submission_Date
			(
    			type = datetime
				displayname = "Submission Date"
				timedisplayoptions = "hh:mm"
				alloweddays = 0,1,2,3,4,5,6
	 			row = 1
	 			column = 1   
				width = medium
			)
			must have Consent_to_Analyse
			(
				type = checkboxes	
				displayname = "Consent to Analyse"
				values = {"Yes","No"}
	 			row = 1
	 			column = 1   
				width = medium
			)
			Feedback_Plain_Text
			(
    			type = textarea
				height = 100px
				private = true
	 			row = 1
	 			column = 1   
				width = medium
			)
			Sentiment
			(
				type = picklist
				maxchar = 100
				private = true
	 			row = 1
	 			column = 1   
				width = medium
						AI_Properties
						(
									fieldtype = SentimentAnalysis
									basefield = Feedback_Plain_Text
						)
			)
	
			actions
			{
				on add
				{
					submit
					(
   						type = submit
   						displayname = "Submit"
					)
				}
				on edit
				{
					update
					(
   						type = submit
   						displayname = "Update"
					)
					cancel
					(
   						type = cancel
   						displayname = "Cancel"
					)
				}
			}
		}
	}
	reports
	{
		default custom Feedback_Submissions_Report
		{
			displayName = "Feedback_Submissions Report"
			show all rows from Feedback_Submissions    
			(
				Feedback_ID as "Feedback ID"
				Feedback_Category as "Feedback Category"
				Product_Service_Name as "Business/Brand Name"
				Rating as "Overall Rating"
				Preffered_Languange as "Prefered Language"
				Consent_to_Analyse as "Consent to Analyse"
				Submission_Date as "Submission Date"
				Customer_Name  as "Customer Name"
				Prod as "Product/Service Name"
				Customer_Email as "Customer Email"
				Your_Feedback as "Your Feedback"
				(
					displayformat = plaintext
				)
				Modified_Time as "Modified Time"
				Feedback_Plain_Text
				Sentiment
			)
			sort by
			(
				Modified_Time descending
			)
			customlayouts
			(
				template
	 			(
	 	  			displayname="Custom Layout 1"
	 	  			content="<panel  \n >\n	<pr \n			width='fill'\n		height='fill'\n>\n	<pc \n		padding = '0px'\n	bgColor = 'theme:30'\n\n		width = '100%'\n		hAlign = 'left'\n		vAlign = 'top'\n>\n	<pr \n			width='fill'\n		height='auto'\n>\n	<pc \n		padding = '0px'\n	bgColor = '#FFF'\n\n		width = '100%'\n		hAlign = 'left'\n		vAlign = 'top'\n    	cornerRadius = '10px'\n>\n	<pr \n			width='fill'\n		height='auto'\n>\n	<pc \n	\n		width = '19%'\n>\n	<pr \n	>\n	<pc \n	\n>\n	<text \n\n	margin = '0px'\n	padding = '0px'\n	color = '#020C27'\n	size = '16px'\n	bold = 'true' \n	type = 'field'\n\n	bgColor = 'transparent'\n        bgColorType = 'noFill'\n	cornerRadius = '0px'\n\n    lineHeight = '23'\n    numOfLines = '1'\n\n\n\n\n    borderColor = '#020C27'\n    borderWidth = '0px'\n\n	  value = 'Rating'\n>\n</text>\n\n</pc>\n</pr><pr \n	>\n	<pc \n	\n>\n	<text \n\n	margin = '0px'\n	padding = '0px'\n	color = '#6B7280'\n	size = '13px'\n	type = 'field'\n\n\n    lineHeight = '18'\n    numOfLines = '1'\n\n\n\n\n\n	  value = 'Feedback_Category'\n>\n</text>\n\n</pc>\n</pr>\n</pc><pc \n		paddingTop = '0px'\n	paddingLeft = '16px'\n	paddingRight = '16px'\n	paddingBottom = '8px'\n\n		width = '81%'\n>\n	<pr \n			width='100%'\n		height='auto'\n>\n	<pc \n	\n>\n	<text \n\n	margin = '0px'\n	color = '#020C27'\n	size = '12px'\n	type = 'field'\n\n\n    lineHeight = '17'\n    numOfLines = '1'\n\n\n\n\n\n	  value = 'Product_Service_Name'\n>\n</text>\n\n</pc><pc \n		paddingTop = '0px'\n	paddingLeft = '0px'\n	paddingBottom = '8px'\n	bgColor = 'transparent'\n        bgColorType = 'noFill'\n\n		width = '100%'\n		hAlign = 'left'\n		vAlign = 'middle'\n>\n	<pr \n			width='100%'\n		height='auto'\n>\n	<pc \n		paddingTop = '10px'\n	paddingLeft = '20px'\n	paddingRight = '20px'\n	paddingBottom = '10px'\n	bgColor = '#F3F3F3'\n\n    borderColor = '#E8ECF0'\n    borderWidth = '1px'\n		width = '33%'\n		hAlign = 'left'\n		vAlign = 'middle'\n    	cornerRadius = '4px'\n>\n	<text \n\n	margin = '0px'\n	color = '#020C27'\n	size = '12px'\n	type = 'field'\n\n\n    lineHeight = '17'\n    numOfLines = '1'\n\n\n\n\n\n	  value = 'Prod'\n>\n</text>\n\n</pc><pc \n		paddingTop = '10px'\n	paddingLeft = '20px'\n	paddingRight = '20px'\n	paddingBottom = '10px'\n	bgColor = '#F3F3F3'\n\n    borderColor = '#E8ECF0'\n    borderWidth = '1px'\n		width = '32%'\n		hAlign = 'left'\n		vAlign = 'middle'\n    	cornerRadius = '4px'\n>\n	<text \n\n	margin = '0px'\n	padding = '0px'\n	color = '#020C27'\n	size = '12px'\n	type = 'field'\n\n	bgColor = 'transparent'\n        bgColorType = 'noFill'\n	cornerRadius = '0px'\n\n    lineHeight = '17'\n    numOfLines = '3'\n\n\n\n\n    borderColor = '#020C27'\n    borderWidth = '0px'\n\n	  value = 'Your_Feedback'\n>\n</text>\n\n</pc>\n</pr>\n</pc>\n</pr>\n</pc>\n</pr>\n</pc>\n</pr>\n</pc>\n</pr>\n</panel>"
	    		)
				template
	 			(
	 	  			displayname="Custom Layout 2"
	 	  			content="<panel  \n >\n	<pr \n			width='fill'\n>\n	<pc \n		padding = '0px'\n	bgColor = 'theme:45'\n\n		width = '100%'\n		hAlign = 'center'\n		vAlign = 'middle'\n>\n	<pr \n			width='fill'\n>\n	<pc \n		bgColor = '#FFF'\n\n		width = '100%'\n    	cornerRadius = '10px'\n>\n	<pr \n			width='fill'\n		height='fill'\n>\n	<pc \n		padding = '16px'\n	bgColor = 'transparent'\n        bgColorType = 'noFill'\n\n		width = '25%'\n		hAlign = 'left'\n		vAlign = 'top'\n    	cornerRadius = '0px'\n>\n	<pr \n			width='auto'\n		height='auto'\n>\n	<pc \n		paddingTop = '0px'\n	paddingLeft = '10px'\n	paddingRight = '0px'\n	paddingBottom = '0px'\n	bgColor = 'transparent'\n        bgColorType = 'noFill'\n\n		hAlign = 'left'\n    	cornerRadius = '0px'\n>\n	<pr \n	>\n	<pc \n	\n>\n	<text \n\n	margin = '0px'\n	padding = '0px'\n	color = '#020C27'\n	size = '24px'\n	bold = 'true' \n	type = 'field'\n\n	bgColor = 'transparent'\n        bgColorType = 'noFill'\n	cornerRadius = '0px'\n\n    lineHeight = '32'\n    numOfLines = '1'\n\n\n\n\n    borderColor = '#020C27'\n    borderWidth = '0px'\n\n	  value = 'Rating'\n>\n</text>\n\n</pc>\n</pr><pr \n	>\n	<pc \n	\n>\n	<text \n\n	marginLeft = '0px'\n	marginRight = '0px' \n	marginBottom = '0px'\n	marginTop = '8px'\n	padding = '0px'\n	color = '#6B7280'\n	size = '14px'\n	type = 'field'\n\n	bgColor = 'transparent'\n        bgColorType = 'noFill'\n	cornerRadius = '0px'\n\n    lineHeight = '19'\n    numOfLines = '1'\n\n\n\n\n\n	  value = 'Feedback_Category'\n>\n</text>\n\n</pc>\n</pr>\n</pc>\n</pr>\n</pc><pc \n		padding = '16px'\n	bgColor = 'transparent'\n        bgColorType = 'noFill'\n\n		width = '17%'\n		hAlign = 'left'\n		vAlign = 'middle'\n    	cornerRadius = '0px'\n>\n	<pr \n			width='auto'\n		height='auto'\n>\n	<pc \n	\n>\n	<text \n\n	margin = '0px'\n	padding = '0px'\n	color = '#020C27'\n	size = '15px'\n	type = 'field'\n\n	bgColor = 'transparent'\n        bgColorType = 'noFill'\n	cornerRadius = '0px'\n\n    lineHeight = '21'\n    numOfLines = '1'\n\n\n\n\n\n	  value = 'Product_Service_Name'\n>\n</text>\n\n</pc>\n</pr>\n</pc><pc \n		padding = '16px'\n	bgColor = 'transparent'\n        bgColorType = 'noFill'\n\n		width = '20%'\n		hAlign = 'left'\n		vAlign = 'middle'\n    	cornerRadius = '0px'\n>\n	<pr \n			width='auto'\n		height='auto'\n>\n	<pc \n	\n>\n	<text \n\n	margin = '0px'\n	padding = '0px'\n	color = '#020C27'\n	size = '15px'\n	type = 'field'\n\n	bgColor = 'transparent'\n        bgColorType = 'noFill'\n	cornerRadius = '0px'\n\n    lineHeight = '20'\n    numOfLines = '1'\n\n\n\n\n    borderColor = '#020C27'\n    borderWidth = '0px'\n\n	  value = 'Customer_Name'\n>\n</text>\n\n</pc>\n</pr>\n</pc><pc \n		padding = '16px'\n	bgColor = 'transparent'\n        bgColorType = 'noFill'\n\n		width = '20%'\n		hAlign = 'left'\n		vAlign = 'middle'\n    	cornerRadius = '0px'\n>\n	<pr \n			width='auto'\n		height='auto'\n>\n	<pc \n	\n>\n	<text \n\n	margin = '0px'\n	padding = '0px'\n	color = '#020C27'\n	size = '15px'\n	type = 'field'\n\n	bgColor = 'transparent'\n        bgColorType = 'noFill'\n	cornerRadius = '0px'\n\n    lineHeight = '20'\n    numOfLines = '3'\n\n\n\n\n    borderColor = '#020C27'\n    borderWidth = '0px'\n\n	  value = 'Your_Feedback'\n>\n</text>\n\n</pc>\n</pr>\n</pc><pc \n		padding = '16px'\n	bgColor = 'transparent'\n        bgColorType = 'noFill'\n\n		width = '18%'\n		hAlign = 'right'\n		vAlign = 'middle'\n    	cornerRadius = '0px'\n>\n	<pr \n			width='auto'\n		height='auto'\n>\n	<pc \n	\n>\n	\n</pc>\n</pr>\n</pc>\n</pr>\n</pc>\n</pr>\n</pc>\n</pr>\n</panel>"
	    		)
			)
		}
		default list Feedback_Analysis_Report
		{
			displayName = "Feedback_Analysis Report"
			show all rows from Feedback_Analysis    
			(
				Feedback_Submissions1 as "Feedback Submissions"
				Detected_Languages as "Detected Languages"
				Sentiment
				Primary_Emotion as "Primary Emotion"
				Possible_Sarcasm as "Possible Sarcasm"
				Main_Topic as "Main Topic"
				Feedback_Summary as "Feedback Summary"
				Urgency
				Confidence_Level as "Confidence Level"
				Requires_Review as "Requires Review"
				Analysis_Status
				Analysis_ID as "Analysis ID"
				Google_Event_ID as "Google Event ID"
				Google_Event_Link as "Google Event Link"
			)
		}
		default list All_Feedback_Reviews
		{
			displayName = "All Feedback Reviews"
			show all rows from Feedback_Review    
			(
				Feedback_Analysis1 as "Feedback Analysis"
				Review_Status as "Review Status"
				Corrected_Sentiment as "Corrected Sentiment"
				Corrected_Emotion as "Corrected Emotion"
				Sarcasm_Confirmed as "Sarcasm Confirmed"
				Reviewer_Notes as "Reviewer Notes"
				Reviewed_By as "Reviewed By"
				Events
			)
		}
		list Feedback_Review_Queue
		{
			displayName = "Feedback_Review_Queue"
			show all rows from Feedback_Analysis  [Analysis_Status == "Needs Review"]  
			(
				Analysis_ID as "Analysis ID"
				Feedback_Submissions1 as "Feedback Submissions"
				Detected_Languages as "Detected Languages"
				Sentiment
				Primary_Emotion as "Primary Emotion"
				Possible_Sarcasm as "Possible Sarcasm"
				Main_Topic as "Main Topic"
				Feedback_Summary as "Feedback Summary"
				Urgency
				Confidence_Level as "Confidence Level"
				Requires_Review as "Requires Review"
				Analysis_Status
			)
		}
	}
	pages
	{
		page PolyglotAI_Dashboard
		{
			displayname = "PolyglotAI_Dashboard"
