		 functions
		 {
			 Deluge
			 {
				 string Create_Feedback_Review_Event(string feedbackSummary, string urgency, string analysisId)
                 {
                 	eventData = Map();
                 	eventData.put("summary","PolyglotAI Review - " + urgency);
                 	eventData.put("description","Feedback requires review.\n\nSummary: " + feedbackSummary + "\nUrgency: " + urgency + "\nAnalysis ID: " + analysisId);
                 	reviewDate = zoho.currentdate.addDay(1).toString("yyyy-MM-dd");
                 	startMap = Map();
                 	startMap.put("dateTime",reviewDate + "T10:00:00+05:30");
                 	startMap.put("timeZone","Asia/Kolkata");
                 	endMap = Map();
                 	endMap.put("dateTime",reviewDate + "T10:15:00+05:30");
                 	endMap.put("timeZone","Asia/Kolkata");
                 	eventData.put("start",startMap);
                 	eventData.put("end",endMap);
                 	response = invokeurl
                 	[
                 		url :"https://www.googleapis.com/calendar/v3/calendars/primary/events"
                 		type :POST
                 		body:eventData.toString()
                 		headers:{"Content-Type":"application/json"}
                 		connection:"google_calendar_connection"
                 	];
                 	if(response.get("id") != null)
                 	{
                 		analysisRecord = Feedback_Analysis[ID == analysisId.toLong()];
                 		analysisRecord.Google_Event_ID=response.get("id");
                 		analysisRecord.Google_Event_Link=response.get("htmlLink");
                 		return "SUCCESS: " + response.get("htmlLink");
                 	}
                 	else
                 	{
                 		return "FAILED: " + response.toString();
                 	}
                 }
				 string Test_Google_Calendar_Event()
                 {
                 	eventData = Map();
                 	eventData.put("summary","PolyglotAI - Calendar Integration Test");
                 	eventData.put("description","Test event created from Zoho Creator.");
                 	startMap = Map();
                 	startMap.put("dateTime","2026-10-29T10:00:00+05:30");
                 	startMap.put("timeZone","Asia/Kolkata");
                 	endMap = Map();
                 	endMap.put("dateTime","2026-10-29T10:15:00+05:30");
                 	endMap.put("timeZone","Asia/Kolkata");
                 	eventData.put("start",startMap);
                 	eventData.put("end",endMap);
                 	response = invokeurl
                 	[
                 		url :"https://www.googleapis.com/calendar/v3/calendars/primary/events"
                 		type :POST
                 		body:eventData.toString()
                 		headers:{"Content-Type":"application/json"}
                 		connection:"google_calendar_connection"
                 	];
                 	info response;
                 	return response.toString();
                 }
			 }
		 }


		workflow
		{
		form
		{
			Analyse_Feedback_Submissi as "Analyse_Feedback_Submissions"
			{
				type =  form
				form = Feedback_Submissions

				record event = on add

				on success
				{
					actions 
					{
						custom deluge script
						(
											apiKey = "your_gemini_api_key";
										analysisRecordID = insert into Feedback_Analysis
										[
											Feedback_Submissions1=input.ID
											Analysis_Status="Pending"
											Added_User=zoho.loginuser
										];
										info "Analysis record ID: " + analysisRecordID;
										try 
										{
											feedbackText = ifnull(input.Your_Feedback,"");
											preferredLanguage = ifnull(input.Preffered_Languange,"Auto Detect");
											if(preferredLanguage == "")
											{
												preferredLanguage = "Auto Detect";
											}
											promptText = "You are PolyglotAI, a multilingual customer feedback analysis system. Analyze the feedback carefully, including code-mixed text, sarcasm, contradictions, and unclear intent. Return ONLY valid JSON without markdown. Required keys: detected_languages (string), sentiment (Positive, Neutral, Negative, Mixed, or Uncertain), primary_emotion (Joy, Anger, Sadness, Fear, Surprise, Disgust, Frustration, Trust, Other, or Uncertain), possible_sarcasm (Yes, No, or Uncertain), main_topic (string), feedback_summary (string), urgency (Low, Medium, High, or Critical), confidence_level (number 0-100), requires_review (boolean). Flag requires_review=true if sarcasm is possible or uncertain, positive wording contradicts a negative experience, sentiment or emotion is unclear, or confidence is below 70. Do not treat enthusiastic positive words as proof of positive sentiment. Preferred language: " + preferredLanguage + ". Feedback: " + feedbackText;
											requestBody = Map();
											contentsList = List();
											contentItem = Map();
											partsList = List();
											partItem = Map();
											partItem.put("text",promptText);
											partsList.add(partItem);
											contentItem.put("parts",partsList);
											contentsList.add(contentItem);
											requestBody.put("contents",contentsList);
											generationConfig = Map();
											generationConfig.put("responseMimeType","application/json");
											generationConfig.put("maxOutputTokens",1000);
											requestBody.put("generationConfig",generationConfig);
											headersMap = Map();
											headersMap.put("Content-Type","application/json");
											headersMap.put("x-goog-api-key",apiKey);
											httpResponse = invokeurl
											[
												url :"https://generativelanguage.googleapis.com/v1beta/models/gemini-3.5-flash-lite:generateContent"
												type :POST
												body:requestBody.toString()
												headers:headersMap
												detailed:true
											];
											info "FULL HTTP RESPONSE:";
											info httpResponse;
											responseCode = httpResponse.get("responseCode");
											responseText = ifnull(httpResponse.get("responseText"),"");
											if(responseCode == 200 && responseText != "")
											{
												apiData = responseText.toMap();
												candidates = apiData.get("candidates");
												if(candidates != null && candidates.size() > 0)
												{
													candidate = candidates.get(0);
													contentMap = candidate.get("content");
													parts = contentMap.get("parts");
													if(parts != null && parts.size() > 0)
													{
														analysisText = parts.get(0).get("text");
														analysisData = analysisText.toMap();
														detectedLanguages = ifnull(analysisData.get("detected_languages"),"Uncertain");
														sentimentValue = ifnull(analysisData.get("sentiment"),"Uncertain");
														emotionValue = ifnull(analysisData.get("primary_emotion"),"Uncertain");
														sarcasmValue = ifnull(analysisData.get("possible_sarcasm"),"Uncertain");
														topicValue = ifnull(analysisData.get("main_topic"),"Unspecified");
														summaryValue = ifnull(analysisData.get("feedback_summary"),"No summary available");
														urgencyValue = ifnull(analysisData.get("urgency"),"Medium");
														confidenceValue = ifnull(analysisData.get("confidence_level"),0);
														reviewValue = ifnull(analysisData.get("requires_review"),true);
														feedbackLower = feedbackText.toLowerCase();
														if(sarcasmValue == "Yes" || sarcasmValue == "Uncertain" || sentimentValue == "Mixed" || sentimentValue == "Uncertain" || confidenceValue < 70)
														{
															reviewValue = true;
														}
														if(feedbackLower.contains("fantastic") || feedbackLower.contains("excellent") || feedbackLower.contains("great") || feedbackLower.contains("amazing") || feedbackLower.contains("best experience") && feedbackLower.contains("broken") || feedbackLower.contains("terrible") || feedbackLower.contains("waited") || feedbackLower.contains("nobody answered") || feedbackLower.contains("never arrived") || feedbackLower.contains("worst"))
														{
															reviewValue = true;
														}
														analysisRecord = Feedback_Analysis[ID == analysisRecordID];
														analysisReference = analysisRecord.Analysis_ID;
														analysisRecord.Detected_Languages=detectedLanguages;
														analysisRecord.Sentiment=sentimentValue;
														analysisRecord.Primary_Emotion=emotionValue;
														analysisRecord.Possible_Sarcasm=sarcasmValue;
														analysisRecord.Main_Topic=topicValue;
														analysisRecord.Feedback_Summary=summaryValue;
														analysisRecord.Urgency=urgencyValue;
														analysisRecord.Confidence_Level=confidenceValue;
														if(reviewValue == true)
														{
															analysisRecord.Requires_Review={"Yes"};
														}
														else
														{
															analysisRecord.Requires_Review={"No"};
														}
														if(reviewValue == true)
														{
															analysisRecord.Analysis_Status="Needs Review";
														}
														else
														{
															analysisRecord.Analysis_Status="Completed";
														}
														if(reviewValue == true)
														{
															try 
															{
																calendarResult = thisapp.Create_Feedback_Review_Event(summaryValue,urgencyValue,analysisReference.toString());
																info "Google Calendar result: " + calendarResult;
															}					catch (calendarError)
															{
																info "Google Calendar event creation failed:";
																info calendarError;
															}
														}
														info "PolyglotAI analysis completed.";
														alertNeeded = false;
														if(reviewValue == true)
														{
															alertNeeded = true;
														}
														if(urgencyValue == "High" || urgencyValue == "Critical")
														{
															alertNeeded = true;
														}
														if(alertNeeded == true)
														{
															alertSubject = "PolyglotAI | Feedback Review Required";
															alertMessage = "<html><body style='font-family:Arial,sans-serif;color:#243044;line-height:1.6;'>" + "<div style='background:#10243a;padding:22px;color:#ffffff;'>" + "<h2 style='margin:0;'>PolyglotAI</h2>" + "<p style='margin:5px 0 0;'>Customer Feedback Review Notification</p>" + "</div>" + "<div style='padding:24px;border:1px solid #dce3eb;'>" + "<p>Dear Administrator,</p>" + "<p>PolyglotAI has identified customer feedback that requires attention. Please review the details below.</p>" + "<h3 style='color:#10243a;'>Feedback Analysis Details</h3>" + "<table style='width:100%;border-collapse:collapse;'>" + "<tr><td style='padding:9px;border-bottom:1px solid #e5e7eb;'><b>Sentiment</b></td><td style='padding:9px;border-bottom:1px solid #e5e7eb;'>" + sentimentValue + "</td></tr>" + "<tr><td style='padding:9px;border-bottom:1px solid #e5e7eb;'><b>Primary Emotion</b></td><td style='padding:9px;border-bottom:1px solid #e5e7eb;'>" + emotionValue + "</td></tr>" + "<tr><td style='padding:9px;border-bottom:1px solid #e5e7eb;'><b>Possible Sarcasm</b></td><td style='padding:9px;border-bottom:1px solid #e5e7eb;'>" + sarcasmValue + "</td></tr>" + "<tr><td style='padding:9px;border-bottom:1px solid #e5e7eb;'><b>Main Topic</b></td><td style='padding:9px;border-bottom:1px solid #e5e7eb;'>" + topicValue + "</td></tr>" + "<tr><td style='padding:9px;border-bottom:1px solid #e5e7eb;'><b>Urgency</b></td><td style='padding:9px;border-bottom:1px solid #e5e7eb;'>" + urgencyValue + "</td></tr>" + "<tr><td style='padding:9px;border-bottom:1px solid #e5e7eb;'><b>Confidence</b></td><td style='padding:9px;border-bottom:1px solid #e5e7eb;'>" + confidenceValue + "%</td></tr>" + "<tr><td style='padding:9px;border-bottom:1px solid #e5e7eb;'><b>Human Review Required</b></td><td style='padding:9px;border-bottom:1px solid #e5e7eb;'>" + reviewValue + "</td></tr>" + "</table>" + "<h3 style='color:#10243a;'>Customer Feedback</h3>" + "<blockquote style='margin:0;padding:12px 16px;background:#f3f6fa;border-left:4px solid #0d9488;'>" + feedbackText + "</blockquote>" + "<h3 style='color:#10243a;'>AI-Generated Summary</h3>" + "<p>" + summaryValue + "</p>" + "<p><b>Required Action:</b> Please access PolyglotAI, open the Review Queue, and verify the analysis. Correct any classifications where necessary.</p>" + "<p style='margin-top:28px;'>Regards,<br><b>PolyglotAI Automated Monitoring System</b></p>" + "<hr style='border:0;border-top:1px solid #e5e7eb;'>" + "<p style='font-size:12px;color:#64748b;'>This is an automated notification. Please do not reply directly to this email.</p>" + "</div></body></html>";
															sendmail
															[
																from :zoho.adminuserid
																to :"polyglot@example.com"
																subject :alertSubject
																message :alertMessage
															]
															info "PolyglotAI email alert attempted.";
														}
													}
													else
													{
														analysisRecord = Feedback_Analysis[ID == analysisRecordID];
														analysisRecord.Analysis_Status="Failed";
														analysisRecord.Feedback_Summary="Gemini returned no analysis text.";
														info "Missing response parts:";
														info responseText;
													}
												}
												else
												{
													analysisRecord = Feedback_Analysis[ID == analysisRecordID];
													analysisRecord.Analysis_Status="Failed";
													analysisRecord.Feedback_Summary="Gemini returned no candidates.";
													info responseText;
												}
											}
											else
											{
												analysisRecord = Feedback_Analysis[ID == analysisRecordID];
												analysisRecord.Analysis_Status="Failed";
												analysisRecord.Feedback_Summary="Gemini request failed. HTTP status: " + responseCode;
												info "GEMINI API ERROR:";
												info responseText;
											}
										}catch (e)
										{
											info "WORKFLOW ERROR:";
											info e;
											info e.message;
											info e.lineNo;
											analysisRecord = Feedback_Analysis[ID == analysisRecordID];
											analysisRecord.Analysis_Status="Failed";
											analysisRecord.Feedback_Summary="Workflow error at line " + e.lineNo + ": " + e.message;
										}
						)
					}
				}

			}
			PolyglotAI_Human_Review_P as "PolyglotAI_Human_Review_Processor"
			{
				type =  form
				form = Feedback_Review

				record event = on add or edit

				on success
				{
					actions 
					{
						custom deluge script
						(
											analysisID = input.Feedback_Analysis1;
										reviewStatus = ifnull(input.Review_Status,"");
										if(analysisID != null)
										{
											analysisRecord = Feedback_Analysis[ID == analysisID];
											if(analysisRecord.ID != null)
											{
												if(reviewStatus == "Reviewed")
												{
													analysisRecord.Analysis_Status="Completed";
													analysisRecord.Requires_Review={"No"};
												}
												else if(reviewStatus == "Correction Required")
												{
													analysisRecord.Analysis_Status="Needs Review";
													analysisRecord.Requires_Review={"Yes"};
												}
											}
										}
						)
					}
				}

			}
			Feedback_plain_text as "Feedback plain text"
			{
				type =  form
				form = Feedback_Submissions

				record event = on add

				on user input of Your_Feedback
				{
					actions 
					{
						custom deluge script
						(
											input.Feedback_Plain_Text = input.Your_Feedback;
						)
					}
				}

			}
		}






